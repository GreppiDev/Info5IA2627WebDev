<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
		<PackageReference Include="Scalar.AspNetCore" Version="3.2.1" />
	</ItemGroup>
	
	<PropertyGroup>
		<UserSecretsId>OpenStreetMaps-42fe3837-6f44-48dd-ac09-b8a6462b91fc</UserSecretsId>
	</PropertyGroup>
	
	<!-- Ensure wwwroot files are copied to output -->
	<ItemGroup>
		<Content Update="wwwroot\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<Folder Include="wwwroot\" />
	</ItemGroup>

</Project>
