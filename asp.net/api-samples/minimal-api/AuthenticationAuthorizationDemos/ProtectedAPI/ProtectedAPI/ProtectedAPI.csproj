  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.2.1" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="11.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <UserSecretsId>ProtectedAPI-f4da2e91-4702-40cb-acd3-99ec91450c0d</UserSecretsId>
  </PropertyGroup>

</Project>
